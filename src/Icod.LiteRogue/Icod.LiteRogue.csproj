<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><PackAsTool>true</PackAsTool><ToolCommandName>literogue</ToolCommandName>
    <Version>1.0.0-alpha.3</Version><PackageVersion>1.0.0-alpha.3</PackageVersion><AssemblyVersion>1.0.0.0</AssemblyVersion>
    <PackageId>Icod.LiteRogue</PackageId><Title>Icod.LiteRogue</Title><Authors>Timothy J. Bruce</Authors>
    <Description>A small turn-based Rogue-style dungeon game using Icod.DCurses.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile><PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/uniblab/Icod.LiteRogue</RepositoryUrl><RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/uniblab/Icod.LiteRogue</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Icod.LiteRogue.Model/Icod.LiteRogue.Model.csproj" />
    <PackageReference Include="Icod.DCurses" Version="2.2.0" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSES/*" Pack="true" PackagePath="LICENSES/" />
    <None Include="../../docs/Playing.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>
</Project>
